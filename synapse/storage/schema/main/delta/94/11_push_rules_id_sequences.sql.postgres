-- The `id` columns of `push_rules` and `push_rules_enable` used to be allocated
-- in-process by the push rules writer. Move them to sequences so that rows can be
-- inserted from any worker (in particular, from background updates).
--
-- An empty table starts its sequence at 1 rather than 0, as `setval` refuses
-- values below the sequence's minimum.

CREATE SEQUENCE push_rules_id_seq;

SELECT setval('push_rules_id_seq', (
    SELECT COALESCE(MAX(id), 1) FROM push_rules
));

CREATE SEQUENCE push_rules_enable_id_seq;

SELECT setval('push_rules_enable_id_seq', (
    SELECT COALESCE(MAX(id), 1) FROM push_rules_enable
));
