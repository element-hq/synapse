-- We need to increase the number of rows to sample for `room_id` column,
-- otherwise the stats will underestimate the number of distinct rooms and make
-- the query planner use the wrong index.
ALTER TABLE device_lists_changes_in_room ALTER COLUMN room_id SET STATISTICS 1000;

-- Manually tell the query planner that we expect the number of distinct values
-- in the `stream_id` column to be proportional to the number of rows.
ALTER TABLE device_lists_changes_in_room ALTER COLUMN stream_id SET (n_distinct = -0.05);
